NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://simple_invoice:simple_invoice@localhost:5432/simple_invoice

# JWT signing secret (32+ random characters) and default token lifetime
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600

# Browser origin allowed to call this API directly
CORS_ORIGIN=http://localhost:3000

# Reviewer account created by `npm run seed` (document the final values in the README)
SEED_USER_EMAIL=reviewer@simpleinvoice.test
SEED_USER_PASSWORD=ReviewerPass123!
SEED_USER_FULLNAME=Assessment Reviewer
