# Overrides for `docker compose up`. Copy to `.env` at the repository root
# and edit as needed — docker-compose loads it automatically. Every value
# below has a working default baked into docker-compose.yml, so this file
# is optional for a local demo run.

# Signing secret for backend-issued JWTs. Change this before any real deployment.
JWT_SECRET=dev-only-change-this-secret-before-any-real-deploy
JWT_EXPIRES_IN_SECONDS=3600

# Browser origin allowed to call the API (CORS) and the browser-reachable API URL.
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Reviewer account created by the backend's seed script (documented in README.md).
SEED_USER_EMAIL=reviewer@simpleinvoice.test
SEED_USER_PASSWORD=ReviewerPass123!
SEED_USER_FULLNAME=Assessment Reviewer
